# ---------------------------------------------------------------------------
# OmTrax CRM — React (Vite) single-page app
# Deployed on Hostinger (Apache / LiteSpeed, both read .htaccess).
#
# Vite copies everything in /public into /dist, so this file ships with the
# build. Upload it alongside index.html in the site root (public_html).
#
# Why this is needed: React Router handles routes in the browser. On a hard
# refresh of e.g. /login the browser asks the SERVER for /login, which is not a
# real file on disk, so Apache returns 404. The rule below serves index.html
# instead and lets React Router resolve the route.
# ---------------------------------------------------------------------------

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Force HTTPS (the app stores an auth token — never send it in the clear)
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # The API lives on api.omtraxcrm.in. Never rewrite /api to the SPA shell —
  # an API path should fail loudly, not silently return HTML.
  RewriteCond %{REQUEST_URI} ^/api/ [NC]
  RewriteRule ^ - [L,R=404]

  # Serve real files and directories as-is (assets, images, robots.txt, ...)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Everything else is a client-side route -> hand it to the React app
  RewriteRule . /index.html [L]
</IfModule>

<IfModule mod_headers.c>
  # Never cache the app shell, otherwise browsers keep loading the previous
  # deploy (and reference asset filenames that no longer exist).
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  # Vite emits content-hashed assets (e.g. index-BDkd1DWB.js) — safe to cache
  # forever, because a new build produces a new filename.
  <FilesMatch "-[A-Za-z0-9_-]{8,}\.(js|css|woff2?|png|jpe?g|svg|gif|webp)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Baseline security headers
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Compress text assets when the server supports it
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

# Fallback for the rare host without mod_rewrite
ErrorDocument 404 /index.html
